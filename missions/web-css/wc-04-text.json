{
  "id": "wc-04-text",
  "region": "web-css",
  "order": 4,
  "title": "Text Styling",
  "story": "Type is most of a page. CSS controls the font, weight, case and alignment.",
  "goal": "Style the h1: centred, bold, uppercase. Style .lead: font-size 20px and italic.",
  "type": "web",
  "lang": "web",
  "starter": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>My Page</title>\n  <style>\n    /* h1 and .lead rules */\n  </style>\n</head>\n<body>\n  <h1>Aata Village</h1>\n  <p class=\"lead\">Learn to code by playing.</p>\n</body>\n</html>\n",
  "tests": [
    {
      "kind": "web",
      "label": "The h1 is centred",
      "js": "return css(\"h1\",\"text-align\") === \"center\" || css(\"h1\",\"text-align\")",
      "hidden": false
    },
    {
      "kind": "web",
      "label": "The h1 is bold",
      "js": "var w = css(\"h1\",\"font-weight\"); return (w === \"bold\" || Number(w) >= 600) || w",
      "hidden": false
    },
    {
      "kind": "web",
      "label": "The h1 is uppercase",
      "js": "return css(\"h1\",\"text-transform\") === \"uppercase\" || css(\"h1\",\"text-transform\")",
      "hidden": false
    },
    {
      "kind": "web",
      "label": ".lead is 20px and italic",
      "js": "return (px(\".lead\",\"font-size\") === 20 && css(\".lead\",\"font-style\") === \"italic\") || px(\".lead\",\"font-size\") + \"px \" + css(\".lead\",\"font-style\")",
      "hidden": false
    }
  ],
  "hints": [
    "text-align, font-weight, text-transform for the h1; font-size and font-style for .lead.",
    "h1 { text-align: center; font-weight: bold; text-transform: uppercase; }",
    "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>My Page</title>\n  <style>\n    h1 {\n      text-align: center;\n      font-weight: bold;\n      text-transform: uppercase;\n    }\n    .lead {\n      font-size: 20px;\n      font-style: italic;\n    }\n  </style>\n</head>\n<body>\n  <h1>Aata Village</h1>\n  <p class=\"lead\">Learn to code by playing.</p>\n</body>\n</html>\n"
  ],
  "socratic": [
    "Does text-transform change the HTML text?",
    "What values can font-style take?",
    "Why is h1 already bold by default?"
  ],
  "explain": "In one sentence: what did you learn from “Text Styling”?",

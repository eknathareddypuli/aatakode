  "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>My Page</title>\n  <style>\n    h1 {\n      text-align: center;\n      font-weight: bold;\n      text-transform: uppercase;\n    }\n    .lead {\n      font-size: 20px;\n      font-style: italic;\n    }\n  </style>\n</head>\n<body>\n  <h1>Aata Village</h1>\n  <p class=\"lead\">Learn to code by playing.</p>\n</body>\n</html>\n"

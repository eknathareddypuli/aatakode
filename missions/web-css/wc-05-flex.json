  "starter": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>My Page</title>\n  <style>\n    .box { padding: 12px; background: #dff; }\n    .row {\n      /* flex here */\n    }\n  </style>\n</head>\n<body>\n  <div class=\"row\">\n    <div class=\"box\">One</div>\n    <div class=\"box\">Two</div>\n    <div class=\"box\">Three</div>\n  </div>\n</body>\n</html>\n",
  "tests": [
    {
      "kind": "web",
      "label": ".row is a flex container",

  "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>My Page</title>\n  <style>\n    li { cursor: pointer; }\n    .right { background: #bbf7d0; }\n    .wrong { background: #fecaca; }\n  </style>\n</head>\n<body>\n  <main>\n    <p id=\"question\">Which tag makes the biggest heading?</p>\n    <ul id=\"choices\"><li>h6</li><li>h1</li><li>head</li></ul>\n    <p id=\"result\"></p>\n    <p id=\"score\">Score: 0</p>\n  </main>\n  <script>\n    var score = 0;\n    var scored = false;\n    var choices = document.querySelectorAll(\"#choices li\");\n    for (var i = 0; i < choices.length; i++) {\n      choices[i].addEventListener(\"click\", function () {\n        var ok = this.textContent === \"h1\";\n        this.classList.add(ok ? \"right\" : \"wrong\");\n        document.getElementById(\"result\").textContent = ok ? \"Correct!\" : \"Try again\";\n        if (ok && !scored) {\n          scored = true;\n          score++;\n          document.getElementById(\"score\").textContent = \"Score: \" + score;\n        }\n      });\n    }\n  </script>\n</body>\n</html>\n",

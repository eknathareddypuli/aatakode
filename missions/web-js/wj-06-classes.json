    "wj-05-create"
  ],
  "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>My Page</title>\n  <style>\n    body.dark { background: #111; color: #eee; }\n  </style>\n</head>\n<body>\n  <button id=\"theme\">Toggle</button>\n  <p>Hello</p>\n  <script>\n    document.getElementById(\"theme\").addEventListener(\"click\", function () {\n      document.body.classList.toggle(\"dark\");\n    });\n  </script>\n</body>\n</html>\n"

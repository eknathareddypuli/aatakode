  "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>My Page</title>\n</head>\n<body>\n  <button id=\"btn\">Press</button>\n  <p id=\"out\">Waiting</p>\n  <script>\n    document.getElementById(\"btn\").addEventListener(\"click\", function () {\n      document.getElementById(\"out\").textContent = \"Clicked!\";\n    });\n  </script>\n</body>\n</html>\n"

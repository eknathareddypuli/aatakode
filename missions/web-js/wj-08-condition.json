  "hints": [
    "Convert with Number(...) then compare with >=.",
    "if (age >= 18) { ... } else { ... }",
    "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>My Page</title>\n</head>\n<body>\n  <input id=\"age\" type=\"number\">\n  <button id=\"check\">Check</button>\n  <p id=\"verdict\"></p>\n  <script>\n    document.getElementById(\"check\").addEventListener(\"click\", function () {\n      var age = Number(document.getElementById(\"age\").value);\n      document.getElementById(\"verdict\").textContent = age >= 18 ? \"Adult\" : \"Minor\";\n    });\n  </script>\n</body>\n</html>\n"
  ],
  "socratic": [

  "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>My Page</title>\n</head>\n<body>\n  <ul id=\"menu\"></ul>\n  <script>\n    var fruits = [\"Mango\", \"Banana\", \"Guava\", \"Papaya\"];\n    for (var i = 0; i < fruits.length; i++) {\n      var li = document.createElement(\"li\");\n      li.textContent = fruits[i];\n      document.getElementById(\"menu\").appendChild(li);\n    }\n  </script>\n</body>\n</html>\n"

  "title": "Read an Input",
  "story": "An input's .value is what the user typed. Read it when the button is clicked.",
  "goal": "When #go is clicked, show Hello, NAME! in #greet using the text in #name.",
  "type": "web",
  "lang": "web",
  "starter": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>My Page</title>\n</head>\n<body>\n  <input id=\"name\" placeholder=\"Your name\">\n  <button id=\"go\">Greet</button>\n  <p id=\"greet\"></p>\n  <script>\n    // read #name.value on click\n  </script>\n</body>\n</html>\n",
  "tests": [

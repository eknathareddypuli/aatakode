  "starter": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>My Page</title>\n</head>\n<body>\n  <button id=\"plus\">+1</button>\n  <span id=\"count\">0</span>\n  <script>\n    var n = 0;\n    // update n and #count on each click\n  </script>\n</body>\n</html>\n",

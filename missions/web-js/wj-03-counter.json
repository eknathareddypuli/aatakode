  "hints": [
    "Keep n outside the function so it remembers between clicks.",
    "n = n + 1; then write n into #count.",
    "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>My Page</title>\n</head>\n<body>\n  <button id=\"plus\">+1</button>\n  <span id=\"count\">0</span>\n  <script>\n    var n = 0;\n    document.getElementById(\"plus\").addEventListener(\"click\", function () {\n      n = n + 1;\n      document.getElementById(\"count\").textContent = n;\n    });\n  </script>\n</body>\n</html>\n"

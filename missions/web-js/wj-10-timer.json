  "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>My Page</title>\n</head>\n<body>\n  <p id=\"n\">0</p>\n  <script>\n    function tick() {\n      var el = document.getElementById(\"n\");\n      el.textContent = Number(el.textContent) + 1;\n    }\n    setInterval(tick, 1000);\n  </script>\n</body>\n</html>\n"

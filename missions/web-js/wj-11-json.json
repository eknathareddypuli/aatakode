    "json",
    "errors"
  ],
  "requires": [
    "wj-10-timer"
  ],
  "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>My Page</title>\n</head>\n<body>\n  <p>JSON helpers</p>\n  <script>\n    function toText(list) {\n      return JSON.stringify(list);\n    }\n    function fromText(text) {\n      try {\n        var v = JSON.parse(text);\n        return Array.isArray(v) ? v : [];\n      } catch (e) {\n        return [];\n      }\n    }\n  </script>\n</body>\n</html>\n"
}

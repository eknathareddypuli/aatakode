  "starter": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>My Page</title>\n</head>\n<body>\n  <p>JSON helpers</p>\n  <script>\n    // function toText(list) { ... }\n    // function fromText(text) { ... }\n  </script>\n</body>\n</html>\n",

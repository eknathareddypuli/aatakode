  "hints": [
    "JSON.stringify makes text; JSON.parse reads it, and throws on bad text.",
    "Wrap JSON.parse in try/catch and return [] in catch.",
    "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>My Page</title>\n</head>\n<body>\n  <p>JSON helpers</p>\n  <script>\n    function toText(list) {\n      return JSON.stringify(list);\n    }\n    function fromText(text) {\n      try {\n        var v = JSON.parse(text);\n        return Array.isArray(v) ? v : [];\n      } catch (e) {\n        return [];\n      }\n    }\n  </script>\n</body>\n</html>\n"
  ],
  "socratic": [
    "Why does JSON.parse need a try/catch here?",
    "What does Array.isArray check?",
    "Why is text the right shape to store?"
  ],
  "explain": "In one sentence: what did you learn from “Saving as Text (JSON)”?",
  "xp": 40,
  "skills": [

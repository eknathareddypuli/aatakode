{
  "id": "git-12-boss-two-features",
  "region": "git-branches",
  "order": 6,
  "title": "Boss: Two Features, One Release",
  "story": "Two teammates finished separate features. Merge both into main and clean up the branches.",
  "goal": "Merge feature/search and feature/export into main, then delete both branches.",
  "type": "terminal",
  "starter": {
    "cwd": "/home/oncall/repo",
    "files": {},
    "git": {
      "root": "/home/oncall/repo",
      "commits": [
        {
          "msg": "base",
          "files": {
            "app.py": "x\n"
          },
          "author": "Asha"
        }
      ],
      "branches": [
        {
          "name": "feature/search",
          "commits": [
            {
              "msg": "add search",
              "files": {
                "search.py": "s\n"
              },
              "author": "Ravi"
            }
          ]
        },
        {
          "name": "feature/export",
          "commits": [
            {
              "msg": "add export",
              "files": {
                "export.py": "e\n"
              },
              "author": "Meena"
            }
          ]
        }
      ],
      "checkout": "main"
    }
  },
  "tests": [
    {
      "kind": "git",
      "check": "in-head",
      "label": "search.py is on main",
      "path": "search.py"
    },
    {
      "kind": "git",
      "check": "in-head",
      "label": "export.py is on main",
      "path": "export.py"
    },
    {
      "kind": "git",
      "check": "no-branch",
      "label": "feature/search deleted",
      "value": "feature/search"
    },
    {
      "kind": "git",
      "check": "no-branch",
      "label": "feature/export deleted",
      "value": "feature/export"
    },
    {
      "kind": "git",
      "check": "branch-is",
      "label": "On main",
      "value": "main"
    }
  ],
  "hints": [
    "Merge one, then the other.",
    "Delete with git branch -d after both merges.",
    "Run:\ngit merge feature/search\ngit merge feature/export\ngit branch -d feature/search\ngit branch -d feature/export"
  ],
  "socratic": [
    "",
    "",
    "Which command shows you the evidence you need?"
  ],
  "explain": "In one sentence: what was the cause, and how did you fix it?",
  "xp": 50,
  "skills": [
    "git"
  ],
  "requires": [
    "git-11-delete-branch"
  ],
  "solution": {
    "commands": [
      "git merge feature/search",
      "git merge feature/export",
      "git branch -d feature/search",
      "git branch -d feature/export"
    ]
  },
  "tool": "git",
  "boss": true
}
